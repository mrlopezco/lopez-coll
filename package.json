{
  "name": "ignacio-web",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "node ./scripts/enforce-yarn.cjs && node .next/standalone/server.js",
    "dev": "node ./scripts/enforce-yarn.cjs && next dev",
    "build": "node ./scripts/enforce-yarn.cjs && next build --webpack",
    "serve": "node ./scripts/enforce-yarn.cjs && next start",
    "analyze": "node ./scripts/enforce-yarn.cjs && cross-env ANALYZE=true next build",
    "lint": "node ./scripts/enforce-yarn.cjs && eslint --fix app components lib layouts scripts --no-error-on-unmatched-pattern",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "^16.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "body-scroll-lock": "^4.0.0-beta.0",
    "clsx": "^2.1.1",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "lodash": "^4.18.1",
    "next": "^16.3.1",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.26",
    "posthog-js": "^1.418.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "supports-color": "^10.2.2",
    "tailwindcss": "^4.3.3",
    "typed.js": "^3.0.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1",
  "resolutions": {
    "cross-spawn": "^7.0.5",
    "micromatch": "^4.0.8"
  }
}
