{
  "name": "ignacio-web",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "node ./scripts/enforce-yarn.cjs && node .next/standalone/server.js",
    "dev": "node ./scripts/enforce-yarn.cjs && next dev",
    "build": "node ./scripts/enforce-yarn.cjs && next build --webpack",
    "serve": "node ./scripts/enforce-yarn.cjs && next start",
    "analyze": "node ./scripts/enforce-yarn.cjs && cross-env ANALYZE=true next build",
    "lint": "node ./scripts/enforce-yarn.cjs && eslint --fix app components lib layouts scripts --no-error-on-unmatched-pattern",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "clsx": "^2.1.1",
    "contentlayer2": "0.5.8",
    "dotenv": "^17.4.2",
    "esbuild": "0.27.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.14",
    "posthog-js": "^1.373.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "supports-color": "^10.2.2",
    "tailwindcss": "^3.4.19",
    "typed.js": "^3.0.0",
    "unist-util-visit": "^5.1.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/lodash": "^4.17.24",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1",
  "resolutions": {
    "cross-spawn": "^7.0.5",
    "micromatch": "^4.0.8"
  }
